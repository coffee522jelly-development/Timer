<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" width="1024" height="1024">
  <!-- Background -->
  <rect width="1024" height="1024" fill="#F4EFE6" />

  <!-- Stopwatch outer ring -->
  <circle cx="512" cy="560" r="300" fill="none" stroke="#4A3219" stroke-width="50" />

  <!-- Stopwatch buttons -->
  <rect x="462" y="150" width="100" height="80" fill="#4A3219" rx="15" />
  <rect x="422" y="100" width="180" height="50" fill="#4A3219" rx="20" />

  <g transform="rotate(45, 512, 560)">
    <rect x="482" y="190" width="60" height="70" fill="#4A3219" rx="10" />
  </g>

  <!-- Coffee Dripper motif inside -->
  <path d="M 340 450 L 684 450 L 600 700 L 424 700 Z" fill="none" stroke="#4A3219" stroke-width="40" stroke-linejoin="round" />
  <!-- Dripper base -->
  <path d="M 400 700 L 624 700" stroke="#4A3219" stroke-width="40" stroke-linecap="round" />

  <!-- Green Accent: Timer hand -->
  <g transform="rotate(35, 512, 560)">
    <line x1="512" y1="560" x2="512" y2="350" stroke="#3A7D44" stroke-width="35" stroke-linecap="round" />
    <circle cx="512" cy="560" r="40" fill="#3A7D44" />
  </g>

  <!-- Steam lines (Coffee motif) in Green -->
  <path d="M 450 380 Q 430 330, 470 280 T 450 180" fill="none" stroke="#3A7D44" stroke-width="25" stroke-linecap="round" opacity="0.9"/>
  <path d="M 570 380 Q 550 330, 590 280 T 570 180" fill="none" stroke="#3A7D44" stroke-width="25" stroke-linecap="round" opacity="0.9"/>
</svg>
